{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "standalone_agent",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/standalone_agent/agent_test.py",
            "console": "integratedTerminal",
            "args": [
                "--overwrite",
                "--messages",
                "test_messages.md",
                "--tools",
                "todo_write",
                "ask_user"
            ],
            "cwd": "${workspaceFolder}/scripts/standalone_agent",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            },
            "envFile": "${workspaceFolder}/docker/.env"
        },
        {
            "name": "Python: 附加到 api 服务",
            "type": "debugpy",
            "request": "attach",
            "connect": {
                "host": "localhost",
                "port": 5678
            },
            "pathMappings": [
                {
                    "localRoot": "${workspaceFolder}",
                    "remoteRoot": "."
                }
            ],
            "subProcess": true,
            // "preLaunchTask": "Docker Compose Up with Debug",
            // "postDebugTask": "Docker Compose Down Debug"
        },
        {
            "name": "Python: 附加到 user-pod-scheduler 服务",
            "type": "debugpy",
            "request": "attach",
            "connect": {
                "host": "localhost",
                "port": 5679
            },
            "pathMappings": [
                {
                    "localRoot": "${workspaceFolder}",
                    "remoteRoot": "."
                }
            ],
            "subProcess": true,
            // "preLaunchTask": "Docker Compose Up with Debug",
            // "postDebugTask": "Docker Compose Down Debug"
        },
        {
            "name": "Python: 附加到 app-notification 服务",
            "type": "debugpy",
            "request": "attach",
            "connect": {
                "host": "localhost",
                "port": 5680
            },
            "pathMappings": [
                {
                    "localRoot": "${workspaceFolder}",
                    "remoteRoot": "."
                }
            ],
            "subProcess": true,
            // "preLaunchTask": "Docker Compose Up with Debug",
            // "postDebugTask": "Docker Compose Down Debug"
        },
    ]
}